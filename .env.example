# Copie para .env e gere SECRET_KEY forte: openssl rand -hex 32
SECRET_KEY='troque-por-uma-chave-forte-gerada-com-openssl-rand-hex-32'
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# prd -> PostgreSQL (Docker Compose) | dev -> SQLite local | test -> memoria
ENVIRONMENT=prd

# Usados apenas quando ENVIRONMENT=prd
POSTGRES_DB=ytdownloader
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Hardening TLS (ative atras de proxy terminador TLS)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
